APP_NAME="Oshel Skin Care & Beauty Clinic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments: use sandbox credentials first; credentials stay server-side.
# Pesapal callback and IPN URLs must be public HTTPS endpoints:
# /api/v1/payments/pesapal/callback and /api/v1/payments/pesapal/ipn.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=
PESAPAL_IPN_URL=
PESAPAL_IPN_ID=
# PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3/api

# M-Pesa Daraja STK Push: callback URL must be a public HTTPS endpoint:
# /api/v1/payments/mpesa/callback.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Optional marketing OAuth credentials. Enable only after provider app review
# and business verification. API publishing and metric sync remain manual-only
# until their provider adapters are implemented and verified.
MARKETING_GOOGLE_CLIENT_ID=
MARKETING_GOOGLE_CLIENT_SECRET=
MARKETING_GOOGLE_SCOPES="openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly"
MARKETING_META_CLIENT_ID=
MARKETING_META_CLIENT_SECRET=
MARKETING_META_SCOPES="public_profile pages_show_list pages_read_engagement instagram_basic"
MARKETING_TIKTOK_CLIENT_KEY=
MARKETING_TIKTOK_CLIENT_SECRET=
MARKETING_TIKTOK_SCOPES="user.info.basic"
MARKETING_WHATSAPP_CLIENT_ID=
MARKETING_WHATSAPP_CLIENT_SECRET=
MARKETING_WHATSAPP_SCOPES="whatsapp_business_management whatsapp_business_messaging"
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Set both values explicitly to create a local administrator during db:seed.
# Do not use shared or production credentials for local test accounts.
# OSHEL_SEED_ADMIN_EMAIL=
# OSHEL_SEED_ADMIN_PASSWORD=
# OSHEL_SEED_ADMIN_NAME=

# Optional local-only demo accounts for each seeded role. Use a unique password
# for your local environment; these accounts are never created outside APP_ENV=local.
# OSHEL_SEED_DEMO_USERS_PASSWORD=
